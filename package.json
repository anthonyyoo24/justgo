{
  "name": "justgo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev:mobile": "node scripts/development/start-mobile.mjs",
    "dev:web": "npm run web -w @justgo/mobile",
    "dev:api": "npm run dev -w @justgo/api",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:journey",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:api": "node scripts/quality/audit-api-dependencies.mjs",
    "test": "npm run test:architecture && npm run test --workspaces",
    "test:architecture": "node --test scripts/quality/*.test.mjs scripts/journeys/*.test.mjs scripts/release/*.test.mjs scripts/backups/*.test.mjs scripts/backups/clock/*.test.mjs scripts/development/*.test.mjs scripts/design/*.test.mjs sites/legal/*.test.mjs",
    "merge:pr": "node scripts/quality/merge-pr.mjs",
    "release:beta:check": "node scripts/release/check-beta.mjs",
    "release:staging:local": "node --import tsx apps/api/scripts/local-staging-release.ts",
    "test:db": "npm run test:db -w @justgo/api",
    "db:migrate": "npm run db:migrate -w @justgo/api",
    "db:generate": "npm run db:generate -w @justgo/api",
    "check": "npm run doctor -w @justgo/mobile && npm run check:static && npm run test --workspaces",
    "check:static": "npm run build:contracts && npm run typecheck && npm run lint && npm run format:check && npm run test:architecture",
    "db:local": "node scripts/local-database.mjs",
    "db:stop": "node scripts/local-database.mjs --stop",
    "build:contracts": "npm run build -w @justgo/contracts",
    "build:legal": "node sites/legal/build.mjs",
    "prepare": "npm run build:contracts",
    "test:coverage": "npm run build:contracts && npm run test:coverage --workspaces",
    "typecheck:journey": "tsc --project e2e/tsconfig.json --noEmit",
    "test:journey": "node --env-file-if-exists=apps/api/.env scripts/journeys/run-journey.mjs",
    "test:migrations": "npm run test:migrations -w @justgo/api",
    "test:exported-web": "playwright test --config e2e/exported-web.config.ts",
    "test:workers": "npm run test:workers -w @justgo/api",
    "profile:workers": "npm run profile:workers -w @justgo/api",
    "test:backup:recovery": "node --env-file-if-exists=apps/api/.env --import tsx scripts/backups/rehearse.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "aws4fetch": "1.0.20",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.28.8",
    "eslint-plugin-testing-library": "7.16.2",
    "expo-doctor": "1.21.6",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "test-renderer": "1.3.1",
    "react-native": "0.88.1"
  }
}
