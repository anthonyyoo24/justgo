{
  "name": "justgo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "dev:mobile": "node scripts/development/start-mobile.mjs",
    "dev:web": "pnpm --filter @justgo/mobile run web",
    "dev:api": "pnpm --filter @justgo/api run dev",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:journey",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:api": "node scripts/quality/audit-api-dependencies.mjs",
    "test": "pnpm run test:architecture && pnpm -r run test",
    "test:architecture": "node --test scripts/quality/*.test.mjs scripts/journeys/*.test.mjs scripts/release/*.test.mjs scripts/backups/*.test.mjs scripts/backups/clock/*.test.mjs scripts/development/*.test.mjs scripts/design/*.test.mjs sites/legal/*.test.mjs",
    "merge:pr": "node scripts/quality/merge-pr.mjs",
    "release:beta:check": "node scripts/release/check-beta.mjs",
    "release:staging:local": "node --import tsx apps/api/scripts/local-staging-release.ts",
    "test:db": "pnpm --filter @justgo/api run test:db",
    "db:migrate": "pnpm --filter @justgo/api run db:migrate",
    "db:generate": "pnpm --filter @justgo/api run db:generate",
    "check": "pnpm --filter @justgo/mobile run doctor && pnpm run check:static && pnpm -r run test",
    "check:static": "pnpm run build:contracts && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:architecture",
    "db:local": "node scripts/local-database.mjs",
    "db:stop": "node scripts/local-database.mjs --stop",
    "build:contracts": "pnpm --filter @justgo/contracts run build",
    "build:legal": "node sites/legal/build.mjs",
    "prepare": "pnpm run build:contracts",
    "test:coverage": "pnpm run build:contracts && pnpm -r run test:coverage",
    "typecheck:journey": "tsc --project e2e/tsconfig.json --noEmit",
    "test:journey": "node --env-file-if-exists=apps/api/.env scripts/journeys/run-journey.mjs",
    "test:migrations": "pnpm --filter @justgo/api run test:migrations",
    "test:exported-web": "playwright test --config e2e/exported-web.config.ts",
    "test:workers": "pnpm --filter @justgo/api run test:workers",
    "test:edge": "pnpm --filter @justgo/api run test:edge",
    "profile:workers": "pnpm --filter @justgo/api run profile:workers",
    "test:backup:recovery": "node --env-file-if-exists=apps/api/.env --import tsx scripts/backups/rehearse.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "aws4fetch": "1.0.20",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.28.8",
    "eslint-plugin-testing-library": "7.16.2",
    "expo-doctor": "1.21.6",
    "globals": "17.14.0",
    "js-yaml": "4.3.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
