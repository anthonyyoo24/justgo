{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "justgo-legal",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false },
  "build": { "command": "node cloudflare.mjs" },
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
