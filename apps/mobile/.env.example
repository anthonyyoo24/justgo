# Public and bundled into the app. Never add database credentials here.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Reviewed public JustGO legal pages for release. In development only, blank values
# use labeled /legal drafts on a loopback API; hosted/release values remain unavailable.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
# Configure once the public App Store listing and social profiles are ready.
# APP_STORE_ID is the numeric Apple ID, not the bundle identifier.
EXPO_PUBLIC_APP_STORE_ID=
EXPO_PUBLIC_INSTAGRAM_URL=
EXPO_PUBLIC_TIKTOK_URL=
EXPO_PUBLIC_TWITTER_URL=
# Set a LAN API address for physical iPhones. Staging/production must use HTTPS.
# Owner-confirmed values before EAS/device distribution; local simulator has a dev-only fallback.
# IOS_BUNDLE_IDENTIFIER=
# EAS project ID is already linked in app.config.ts (public project metadata).

# Errors only. Explicit enablement/environment and a matching US ingestion DSN are required.
# Owner-approved: minimal Privacy Policy diagnostics before onboarding acceptance.
# Keep disabled until matching notices/provider review and signed-build checks are ready.
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN is a private build/CI upload credential. Never use EXPO_PUBLIC_ for it.
# Reporting-enabled Release builds require it; Debug/disabled builds skip uploads.
# Native capture requires a compatible rebuilt binary with the native privacy plugin.
# Changing this flag over OTA cannot disable reporting baked into a native binary.
