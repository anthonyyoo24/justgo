{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.18.0",
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "IOS_BUNDLE_IDENTIFIER": "dev.justgo.foundation",
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "24.18.0",
      "environment": "preview"
    },
    "production": {
      "node": "24.18.0",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
