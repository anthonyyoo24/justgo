# Runtime: restricted justgo_runtime user, Supabase transaction pooler port 6543.
# Local development: localhost:54329 with DATABASE_SSL=disable.
NODE_ENV=development
# Separate application environment; Vercel production slots can host test servers.
# Only staging accepts operator-approved account grants. Keep these private.
APP_ENVIRONMENT=production
BETA_ACCESS_GRANTS=[]
PORT=3000
DATABASE_URL=postgresql://justgo_runtime.PROJECT_REF:REPLACE_ME@POOLER_HOST:6543/postgres
DATABASE_SSL=verify-full
# Optional PEM CA certificate supplied by the database host, as a secret.
# DATABASE_CA_CERT=
DATABASE_POOL_MAX=1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081
# Production: independent random secret (at least 32 characters), never bundled in mobile.
# IDENTITY_RATE_LIMIT_KEY=
IDENTITY_SESSION_HOURS=168
IDENTITY_TRANSFER_MINUTES=10
IDENTITY_RECOVERY_RATE_LIMIT=30
# Per verified account per ten minutes. New write batches and export pages use
# separate budgets; identical accepted write retries do not consume another slot.
ACTIVITY_WRITE_RATE_LIMIT=600
ACCOUNT_EXPORT_RATE_LIMIT=600
# Enable only after coordinated schema/provider setup and the reviewed live
# private live-session helper. These values must belong to the same Supabase project.
MANAGED_AUTH_ENABLED=false
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only administrative key for hard Auth account deletion. Never bundle it.
# SUPABASE_AUTH_SECRET_KEY=
# Only in a migration operator's environment; NEVER deploy this on Vercel.
MIGRATION_DATABASE_URL=postgresql://justgo_migrator.PROJECT_REF:REPLACE_ME@POOLER_HOST:5432/postgres
# Isolated loopback test fixtures only; NEVER deploy an operator URL on Vercel.
# JUSTGO_TEST_ADMIN_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/justgo_test
