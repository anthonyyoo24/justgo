          "name": "attempt_outcome_fields",
          "value": "(\"justgo\".\"attempts\".\"status\" = 'active' and \"justgo\".\"attempts\".\"ended_at\" is null and \"justgo\".\"attempts\".\"time_zone\" is null and \"justgo\".\"attempts\".\"elapsed_seconds\" is null and \"justgo\".\"attempts\".\"completion_date\" is null) or (\"justgo\".\"attempts\".\"status\" <> 'active' and \"justgo\".\"attempts\".\"ended_at\" is not null and \"justgo\".\"attempts\".\"elapsed_seconds\" is not null and \"justgo\".\"attempts\".\"ended_at\" >= \"justgo\".\"attempts\".\"started_at\" and \"justgo\".\"attempts\".\"time_zone\" is not null and \"justgo\".\"attempts\".\"elapsed_seconds\" >= 0 and ((\"justgo\".\"attempts\".\"status\" = 'completed' and \"justgo\".\"attempts\".\"completion_date\" is not null) or (\"justgo\".\"attempts\".\"status\" = 'given_up' and \"justgo\".\"attempts\".\"completion_date\" is null)))"
        },
        "attempt_deadline": {
          "name": "attempt_deadline",
          "value": "\"justgo\".\"attempts\".\"deadline_at\" > \"justgo\".\"attempts\".\"started_at\""
        }
      },
