        "attempt_activity_date": {
          "name": "attempt_activity_date",
          "value": "\"justgo\".\"attempts\".\"activity_date\" ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'"
        },
        "attempt_time_zone_attribution": {
          "name": "attempt_time_zone_attribution",
          "value": "(\"justgo\".\"attempts\".\"start_time_zone\" is not null and \"justgo\".\"attempts\".\"legacy_display_time_zone\" is null) or (\"justgo\".\"attempts\".\"start_time_zone\" is null and \"justgo\".\"attempts\".\"legacy_display_time_zone\" is not null)"
        },
        "attempt_reflection_content": {
          "name": "attempt_reflection_content",
          "value": "(\"justgo\".\"attempts\".\"reflection_revision\" = 0 and \"justgo\".\"attempts\".\"reflection_feeling\" is null and \"justgo\".\"attempts\".\"reflection_text\" is null) or (\"justgo\".\"attempts\".\"reflection_revision\" > 0 and (\"justgo\".\"attempts\".\"reflection_feeling\" is not null or \"justgo\".\"attempts\".\"reflection_text\" is not null))"
        },
        "attempt_reflection_feeling": {
          "name": "attempt_reflection_feeling",
          "value": "\"justgo\".\"attempts\".\"reflection_feeling\" is null or \"justgo\".\"attempts\".\"reflection_feeling\" in ('a_lot_worse','a_little_worse','about_the_same','a_little_better','a_lot_better')"
        },
        "attempt_reflection_text_length": {
          "name": "attempt_reflection_text_length",
          "value": "\"justgo\".\"attempts\".\"reflection_text\" is null or char_length(\"justgo\".\"attempts\".\"reflection_text\") <= 10000"
        }
      },
      "isRLSEnabled": true
    },
