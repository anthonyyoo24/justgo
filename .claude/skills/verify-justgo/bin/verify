#!/bin/sh
# Run from the JustGO repository root. See ../SKILL.md for when to use each command.
set -eu

skill=$(cd "$(dirname "$0")/.." && pwd)
if ! grep -q '"name": "justgo"' package.json 2>/dev/null; then
  echo "Run bin/verify from the JustGO repository root" >&2
  exit 2
fi
pg_bin=${JUSTGO_PG_BIN:-/opt/homebrew/opt/postgresql@17/bin}
db_marker=.local/verify-justgo/database-started
tsx_node() {
  node --import tsx --env-file-if-exists=apps/api/.env "$@"
}
database() {
  mkdir -p .local/verify-justgo
  if ! "$pg_bin/pg_ctl" -D .local/postgres status >/dev/null 2>&1; then
    : >"$db_marker"
  fi
  pnpm run db:local
}
run_id() {
  echo "${JUSTGO_VERIFY_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$1}"
}

command=${1:-}
[ $# -gt 0 ] && shift
case "$command" in
doctor)
  tsx_node "$skill/bin/doctor.ts" "$@"
  ;;
drive)
  [ $# -gt 0 ] || {
    echo "Usage: bin/verify drive <feature>... [--playwright-flag]" >&2
    exit 2
  }
  id=$(run_id "$1")
  specs=
  for arg in "$@"; do
    case "$arg" in
    -*) specs="$specs $arg" ;;
    *)
      [ -f "$skill/drives/$arg.spec.ts" ] || {
        echo "No drive for $arg; see $skill/drives" >&2
        exit 2
      }
      specs="$specs $skill/drives/$arg.spec.ts"
      ;;
    esac
  done
  database
  echo "Evidence: .local/verify-justgo/$id"
  # shellcheck disable=SC2086
  JUSTGO_VERIFY_RUN_ID=$id pnpm run test:journey \
    "--config=$skill/verify.config.ts" $specs
  ;;
serve)
  id=$(run_id serve)
  database
  tsx_node "$skill/bin/serve.ts" start "$id"
  ;;
stop)
  status=0
  if [ -f .local/verify-justgo/serving.json ]; then
    if tsx_node "$skill/bin/doctor.ts" 2>/dev/null | node -e '
      let s = "";
      process.stdin.on("data", (d) => (s += d));
      process.stdin.on("end", () => process.exit(JSON.parse(s).state === "serving" ? 0 : 1));
    '; then
      id=$(node -p 'require("./.local/verify-justgo/serving.json").runId')
      JUSTGO_VERIFY_RUN_ID=$id JUSTGO_VERIFY_ATTACH=1 node \
        --env-file-if-exists=apps/api/.env node_modules/@playwright/test/cli.js \
        test "--config=$skill/verify.config.ts" || status=$?
    else
      echo "Skipped fixture cleanup: the recorded services no longer own their ports" >&2
      status=1
    fi
  fi
  tsx_node "$skill/bin/serve.ts" stop || status=$?
  if [ -f "$db_marker" ]; then
    pnpm run db:stop || status=$?
    rm -f "$db_marker"
  fi
  exit "$status"
  ;;
worktree)
  common=$(git rev-parse --path-format=absolute --git-common-dir)
  if [ "$(git rev-parse --path-format=absolute --git-dir)" = "$common" ]; then
    echo "bin/verify worktree runs in a linked worktree, not the main checkout" >&2
    exit 2
  fi
  main=$(dirname "$common")
  case "${1:-}" in
  prepare)
    # db:local uses ./.local, so a worktree shares the main checkout's cluster
    # through a link instead of starting a second one on the same port.
    if [ -L .local ]; then
      if [ "$(readlink .local)" != "$main/.local" ]; then
        echo ".local links to $(readlink .local), not $main/.local. Remove the link and rerun." >&2
        exit 1
      fi
    elif [ -e .local ]; then
      echo ".local is a folder here. Move anything you need out of it, remove it and rerun." >&2
      exit 1
    else
      ln -s "$main/.local" .local
    fi
    # Linked packages let Metro serve another checkout's transform. Removing a
    # link leaves its target alone, and the install clones from the pnpm store.
    for dir in . apps/mobile apps/api packages/contracts; do
      if [ -L "$dir/node_modules" ]; then rm "$dir/node_modules"; fi
    done
    pnpm install --frozen-lockfile
    # Starts the shared database and writes only missing apps/*/.env files.
    pnpm run db:local
    echo "Prepared. .local links to $main/.local. Run bin/verify doctor, then drive."
    ;;
  teardown)
    here=$(pwd -P)
    if [ -f .local/verify-justgo/serving.json ] &&
      [ "$(node -p 'require("./.local/verify-justgo/serving.json").root')" = "$here" ]; then
      echo "This checkout is serving. Run bin/verify stop first." >&2
      exit 1
    fi
    if [ -L .local ]; then
      rm .local
      echo "Removed the .local link. Evidence stays in $main/.local/verify-justgo."
    fi
    echo "From $main, run: git worktree remove $here"
    ;;
  *)
    echo "Usage: bin/verify worktree prepare | teardown" >&2
    exit 2
    ;;
  esac
  ;;
*)
  echo "Usage: bin/verify doctor | drive <feature> | serve | stop | worktree prepare|teardown" >&2
  exit 2
  ;;
esac
